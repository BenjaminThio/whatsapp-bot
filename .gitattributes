# Normalise line endings on commit, check out native.
# Both bots are edited on Windows and run on Termux (Linux).
* text=auto

# The C sources build the dict binaries on the host; keep them LF so the
# Termux toolchain never sees CRLF.
*.c   text eol=lf
*.h   text eol=lf
*.cpp text eol=lf
*.py  text eol=lf
*.sh  text eol=lf

# Never touch binary payloads.
*.png binary
*.jpg binary
*.node binary
*.exe binary
*.dat binary
*.idx binary
