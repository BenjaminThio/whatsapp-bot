# ── Dependencies ─────────────────────────────────────────────────────────────
# One hoisted tree at the workspace root.
node_modules/

# ── Python ───────────────────────────────────────────────────────────────────
# One venv at the workspace root, shared by both bots.
.venv/
__pycache__/
*.pyc

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# configure-env.sh keeps the previous version alongside the new one
.env.bak
*.env.bak

# hi-hive credentials: student ids, session tokens, fcm tokens, AES material.
# shared/hi-hive/creds.json and shared/hi-hive/legacy/creds.json are BOTH real.
creds.json

serviceAccountKey.json
firebase-key.json
*.session

# WhatsApp session state - re-pairing is required if this is lost, and it is
# equivalent to a logged-in device.
whatsapp/auth_info_baileys/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
out/
*.tsbuildinfo
*.tgz
telegram/src/pixelforge/build/

# Compiled binaries. Every one of these is platform-specific and is rebuilt
# from source on each host - see SETUP-TERMUX.md.
*.exe
*.node
shared/assets/dict/dict_lookup
shared/assets/dict/dict_indexer

# ── Large assets ─────────────────────────────────────────────────────────────
# The dict index is ~680 MB and the emoji dataset 60 MB. Copy them in from a
# backup, or rebuild the index with shared/assets/dict/src/dict_indexer.c.
shared/assets/dict/dict.dat
shared/assets/dict/dict.idx
# shared/assets/data/emoji.jsonl

# The raw Wiktionary dump - 11 GB, and only ever an input to the indexer.
enwiktionary-*.xml
enwiktionary-*.xml.bz2

# Where build-dict.sh stages the dump when /sdcard is not available.
.dictwork/

# Generated on first use, rebuilt whenever the dataset changes.
# shared/assets/data/emoji.index.json

# ── Logs / caches / coverage ─────────────────────────────────────────────────
*.log
logs/
report.[0-9]*.json
coverage/
*.lcov
.cache/
.eslintcache

# ── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
