{
  "name": "lasma",
  "private": true,
  "type": "module",
  "description": "Lasma - a WhatsApp bot and a Telegram bot over one shared core.",
  "workspaces": [
    "shared",
    "whatsapp",
    "telegram"
  ],
  "scripts": {
    "whatsapp": "bun --filter whatsapp start",
    "telegram": "bun --filter telegram start",
    "dev:whatsapp": "bun --filter whatsapp dev",
    "dev:telegram": "bun --filter telegram dev",
    "schema": "bun run shared/db/apply-schema.ts",
    "typecheck": "bun run typecheck:whatsapp && bun run typecheck:telegram",
    "typecheck:whatsapp": "cd whatsapp && tsc --noEmit",
    "typecheck:telegram": "cd telegram && tsc --noEmit",
    "migrate:firestore": "cd telegram && bun run scripts/migrate-firestore.ts",
    "studio": "bun run tools/db-studio/server.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  }
}
